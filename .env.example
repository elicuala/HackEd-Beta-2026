# Copy to .env. Never commit .env.
PORT=3000

# OpenAI (Agent B: realtime voice, Agent L: judge)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=      # check current model id in the Realtime docs
OPENAI_REALTIME_VOICE=      # scammer voice
OPENAI_TRANSCRIBE_MODEL=    # optional: caller speech-to-text model (default gpt-4o-transcribe)
JUDGE_MODEL=                # small, fast model with structured outputs
JUDGE_MOCK=0                # 1 = judge uses keyword mock, no network

# Twilio (Agent B: phone drills)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=         # +1XXXXXXXXXX
ALLOWED_NUMBERS=            # comma-separated E.164 numbers that consented
PUBLIC_URL=                 # https://xxxx.ngrok-free.app (no trailing slash)

# Accounts (optional; needs Node 22.5+ for node:sqlite, otherwise accounts answer AUTH_DISABLED)
AUTH_SECRET=                # random string used to hash emails; if blank, one is generated and kept in the database
AUTH_DB_PATH=               # default: data/scam-drill.db (git-ignored)
